# ─────────────────────────────────────────────
#  Boxing AI Performance Analyzer — .gitignore
# ─────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Project-specific: large binary files
data/*.mp4
data/*.avi
data/*.mov
data/*.mkv
data/*.webm

# YOLO model weights (auto-downloaded by Ultralytics)
*.pt
*.onnx
*.engine
*.trt

# Outputs (keep the folder, ignore generated content)
outputs/*
!outputs/.gitkeep

# Streamlit cache
.streamlit/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
